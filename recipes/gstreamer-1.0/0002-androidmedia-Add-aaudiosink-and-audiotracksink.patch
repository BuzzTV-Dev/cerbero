diff --git a/subprojects/gst-plugins-bad/sys/androidmedia/gstandroidaudio.c b/subprojects/gst-plugins-bad/sys/androidmedia/gstandroidaudio.c
new file mode 100644
index 0000000000..134c5167bd
--- /dev/null
+++ b/subprojects/gst-plugins-bad/sys/androidmedia/gstandroidaudio.c
@@ -0,0 +1,286 @@
+/*
+ * Copyright (C) 2026 BuzzTV
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Library General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Library General Public License for more details.
+ *
+ * You should have received a copy of the GNU Library General Public
+ * License along with this library; if not, write to the
+ * Free Software Foundation, Inc., 51 Franklin St, Fifth Floor,
+ * Boston, MA 02110-1301, USA.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <stdlib.h>
+#include <sys/system_properties.h>
+
+#include "gstandroidaudio.h"
+
+#define POS(p) GST_AUDIO_CHANNEL_POSITION_MASK (p)
+
+#define GST_FL POS (FRONT_LEFT)
+#define GST_FR POS (FRONT_RIGHT)
+#define GST_FC POS (FRONT_CENTER)
+#define GST_LFE POS (LFE1)
+#define GST_RL POS (REAR_LEFT)
+#define GST_RR POS (REAR_RIGHT)
+#define GST_RC POS (REAR_CENTER)
+#define GST_SL POS (SIDE_LEFT)
+#define GST_SR POS (SIDE_RIGHT)
+
+/* AAudio's AAUDIO_CHANNEL_* bits */
+#define AA_FL (1 << 0)
+#define AA_FR (1 << 1)
+#define AA_FC (1 << 2)
+#define AA_LFE (1 << 3)
+#define AA_BL (1 << 4)
+#define AA_BR (1 << 5)
+#define AA_BC (1 << 8)
+#define AA_SL (1 << 9)
+#define AA_SR (1 << 10)
+
+typedef struct
+{
+  gint channels;
+  guint64 gst_mask;
+  guint32 android_mask;
+} Layout;
+
+/* The layouts Android's own players open (the same table as ExoPlayer's and
+ * mpv's AudioTrack outputs). The side-surround variants that AC-3 and AAC
+ * decoders commonly emit map onto the back-surround Android layout of the
+ * same channel count: both orders put those two channels in the same slots,
+ * so no reordering is involved, and Android itself treats "5.1" as
+ * back-surround. Every GStreamer layout listed is in canonical order that
+ * matches the Android order of its mask, so the ring buffer never has to
+ * reorder. */
+static const Layout layouts[] = {
+  {1, 0, AA_FL},
+  {2, GST_FL | GST_FR, AA_FL | AA_FR},
+  {3, GST_FL | GST_FR | GST_FC, AA_FL | AA_FR | AA_FC},
+  {4, GST_FL | GST_FR | GST_RL | GST_RR, AA_FL | AA_FR | AA_BL | AA_BR},
+  {4, GST_FL | GST_FR | GST_SL | GST_SR, AA_FL | AA_FR | AA_BL | AA_BR},
+  {5, GST_FL | GST_FR | GST_FC | GST_RL | GST_RR,
+      AA_FL | AA_FR | AA_FC | AA_BL | AA_BR},
+  {5, GST_FL | GST_FR | GST_FC | GST_SL | GST_SR,
+      AA_FL | AA_FR | AA_FC | AA_BL | AA_BR},
+  {6, GST_FL | GST_FR | GST_FC | GST_LFE | GST_RL | GST_RR,
+      AA_FL | AA_FR | AA_FC | AA_LFE | AA_BL | AA_BR},
+  {6, GST_FL | GST_FR | GST_FC | GST_LFE | GST_SL | GST_SR,
+      AA_FL | AA_FR | AA_FC | AA_LFE | AA_BL | AA_BR},
+  {7, GST_FL | GST_FR | GST_FC | GST_LFE | GST_RL | GST_RR | GST_RC,
+      AA_FL | AA_FR | AA_FC | AA_LFE | AA_BL | AA_BR | AA_BC},
+  {8, GST_FL | GST_FR | GST_FC | GST_LFE | GST_RL | GST_RR | GST_SL | GST_SR,
+      AA_FL | AA_FR | AA_FC | AA_LFE | AA_BL | AA_BR | AA_SL | AA_SR},
+};
+
+gint
+gst_android_audio_get_api_level (void)
+{
+  static gsize api_level = 0;
+
+  if (g_once_init_enter (&api_level)) {
+    char value[PROP_VALUE_MAX] = { 0, };
+    gint level = 0;
+
+    if (__system_property_get ("ro.build.version.sdk", value) > 0)
+      level = atoi (value);
+
+    g_once_init_leave (&api_level, level > 0 ? level : 1);
+  }
+
+  return (gint) api_level;
+}
+
+/* One structure per layout, each carrying every format in @formats. */
+GstCaps *
+gst_android_audio_pcm_caps (const gchar * const *formats, gint max_channels)
+{
+  GstCaps *caps = gst_caps_new_empty ();
+  GValue format_list = G_VALUE_INIT;
+  guint i;
+
+  gst_value_list_init (&format_list, 0);
+  for (i = 0; formats[i]; i++) {
+    GValue v = G_VALUE_INIT;
+
+    g_value_init (&v, G_TYPE_STRING);
+    g_value_set_string (&v, formats[i]);
+    gst_value_list_append_and_take_value (&format_list, &v);
+  }
+
+  for (i = 0; i < G_N_ELEMENTS (layouts); i++) {
+    GstStructure *s;
+
+    if (layouts[i].channels > max_channels)
+      break;
+
+    s = gst_structure_new ("audio/x-raw",
+        "layout", G_TYPE_STRING, "interleaved",
+        "rate", GST_TYPE_INT_RANGE, 8000, 192000,
+        "channels", G_TYPE_INT, layouts[i].channels, NULL);
+    gst_structure_set_value (s, "format", &format_list);
+    if (layouts[i].channels > 1)
+      gst_structure_set (s, "channel-mask", GST_TYPE_BITMASK,
+          layouts[i].gst_mask, NULL);
+
+    gst_caps_append_structure (caps, s);
+  }
+
+  g_value_unset (&format_list);
+
+  return caps;
+}
+
+/* Parsed frames only, one per buffer, as gst_audio_iec61937_payload() needs.
+ * E-AC-3 is taken frame-aligned: the upstream payloader refuses
+ * alignment=iec61937, so a stream whose frames have fewer than six audio
+ * blocks is not packed as the standard wants. Broadcast E-AC-3 uses six. */
+GstCaps *
+gst_android_audio_passthrough_caps (guint passthrough)
+{
+  GstCaps *caps = gst_caps_new_empty ();
+
+  if (passthrough & GST_ANDROID_AUDIO_PASSTHROUGH_AC3)
+    gst_caps_append (caps,
+        gst_caps_from_string ("audio/x-ac3, framed = (boolean) true, "
+            "rate = (int) { 32000, 44100, 48000 }"));
+  if (passthrough & GST_ANDROID_AUDIO_PASSTHROUGH_EAC3)
+    gst_caps_append (caps,
+        gst_caps_from_string ("audio/x-eac3, framed = (boolean) true, "
+            "alignment = (string) frame, rate = (int) { 32000, 44100, 48000 }"));
+  if (passthrough & GST_ANDROID_AUDIO_PASSTHROUGH_DTS)
+    gst_caps_append (caps,
+        gst_caps_from_string ("audio/x-dts, framed = (boolean) true, "
+            "block-size = (int) { 512, 1024, 2048 }, "
+            "rate = (int) { 32000, 44100, 48000 }"));
+
+  return caps;
+}
+
+/* The Android (AAudio-numbered) mask for @info, or 0 if the layout is not one
+ * the sinks open. */
+guint32
+gst_android_audio_channel_mask (const GstAudioInfo * info)
+{
+  guint64 gst_mask = 0;
+  guint i;
+
+  if (info->channels > 1 &&
+      !gst_audio_channel_positions_to_mask (info->position, info->channels,
+          FALSE, &gst_mask))
+    return 0;
+
+  for (i = 0; i < G_N_ELEMENTS (layouts); i++) {
+    if (layouts[i].channels == info->channels &&
+        (info->channels == 1 || layouts[i].gst_mask == gst_mask))
+      return layouts[i].android_mask;
+  }
+
+  return 0;
+}
+
+gboolean
+gst_android_audio_spec_is_passthrough (const GstAudioRingBufferSpec * spec)
+{
+  switch (spec->type) {
+    case GST_AUDIO_RING_BUFFER_FORMAT_TYPE_AC3:
+    case GST_AUDIO_RING_BUFFER_FORMAT_TYPE_EAC3:
+    case GST_AUDIO_RING_BUFFER_FORMAT_TYPE_DTS:
+      return TRUE;
+    default:
+      return FALSE;
+  }
+}
+
+/* The rate of the 2-channel, 16-bit IEC 61937 stream carrying @spec: the
+ * codec rate for AC-3 and DTS, four times it for E-AC-3, whose ring buffer
+ * frames are 16 bytes wide. */
+gint
+gst_android_audio_iec61937_rate (const GstAudioRingBufferSpec * spec)
+{
+  return GST_AUDIO_INFO_RATE (&spec->info) * (GST_AUDIO_INFO_BPF (&spec->info)
+      / 4);
+}
+
+/* Beyond the caps intersection: compressed input must be framed and have a
+ * size the payloader can handle, as in alsasink. */
+gboolean
+gst_android_audio_accept_caps (GstAudioBaseSink * sink, GstCaps * caps)
+{
+  GstPad *pad = GST_BASE_SINK_PAD (sink);
+  GstAudioRingBufferSpec spec = { 0, };
+  GstCaps *pad_caps;
+  gboolean ret = FALSE;
+
+  pad_caps = gst_pad_query_caps (pad, caps);
+  if (!pad_caps || gst_caps_is_empty (pad_caps)) {
+    gst_clear_caps (&pad_caps);
+    return FALSE;
+  }
+  gst_caps_unref (pad_caps);
+
+  if (!gst_caps_is_fixed (caps))
+    return TRUE;
+
+  spec.latency_time = GST_SECOND;
+  if (!gst_audio_ring_buffer_parse_caps (&spec, caps))
+    goto done;
+
+  if (gst_android_audio_spec_is_passthrough (&spec)) {
+    ret = gst_audio_iec61937_frame_size (&spec) > 0;
+  } else {
+    ret = spec.type == GST_AUDIO_RING_BUFFER_FORMAT_TYPE_RAW &&
+        gst_android_audio_channel_mask (&spec.info) != 0;
+  }
+
+done:
+  gst_caps_replace (&spec.caps, NULL);
+  return ret;
+}
+
+/* Android takes IEC 61937 as native-endian 16-bit words. */
+GstBuffer *
+gst_android_audio_payload (GstAudioBaseSink * sink, GstBuffer * buf)
+{
+  GstAudioRingBufferSpec *spec = &sink->ringbuffer->spec;
+  GstMapInfo iinfo, oinfo;
+  GstBuffer *out;
+  gint framesize;
+
+  if (!gst_android_audio_spec_is_passthrough (spec))
+    return gst_buffer_ref (buf);
+
+  framesize = gst_audio_iec61937_frame_size (spec);
+  if (framesize <= 0)
+    return NULL;
+
+  out = gst_buffer_new_and_alloc (framesize);
+
+  gst_buffer_map (buf, &iinfo, GST_MAP_READ);
+  gst_buffer_map (out, &oinfo, GST_MAP_WRITE);
+
+  if (!gst_audio_iec61937_payload (iinfo.data, iinfo.size,
+          oinfo.data, oinfo.size, spec, G_BYTE_ORDER)) {
+    gst_buffer_unmap (buf, &iinfo);
+    gst_buffer_unmap (out, &oinfo);
+    gst_buffer_unref (out);
+    return NULL;
+  }
+
+  gst_buffer_unmap (buf, &iinfo);
+  gst_buffer_unmap (out, &oinfo);
+
+  gst_buffer_copy_into (out, buf, GST_BUFFER_COPY_METADATA, 0, -1);
+  return out;
+}
