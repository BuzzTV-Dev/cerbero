+typedef void (*JobFunc) (GstAudioTrackSink * self, JNIEnv * env,
+    gpointer data);
+
+typedef struct
+{
+  JobFunc func;
+  gpointer data;
+  gboolean done;
+} Job;
+
+struct _GstAudioTrackSink
+{
+  GstAudioSink parent;
