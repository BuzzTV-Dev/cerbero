+#define ENCODING_PCM_FLOAT 4
+#define ENCODING_AC3 5
+#define ENCODING_E_AC3 6
+#define ENCODING_DTS 7
+#define ENCODING_IEC61937 13
+#define ENCODING_PCM_24BIT_PACKED 21
