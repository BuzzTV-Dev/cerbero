+/**
+ * SECTION:element-aaudiosink
+ * @title: aaudiosink
+ *
+ * Audio sink on the NDK AAudio API.
+ *
+ * Plays PCM in the layouts Android opens (mono to 7.1, see the pad
+ * template), which needs API 32 (AAudioStreamBuilder_setChannelMask) for
+ * more than two channels; below that only mono and stereo are offered.
+ * With #GstAAudioSink:passthrough set, on API 34 and newer it also takes
+ * parsed AC-3, E-AC-3 and DTS and sends them as IEC 61937
+ * (AAUDIO_FORMAT_IEC61937) for an external decoder. For passthrough below
+ * API 34, use audiotracksink.
+ *
+ * libaaudio is loaded at runtime, so the plugin still loads on devices
+ * without it; the element is simply not registered there.
+ *
+ * ## Example pipeline
+ * |[
+ * gst-launch-1.0 audiotestsrc ! audioconvert ! audio/x-raw,channels=6 ! aaudiosink
+ * ]|
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <string.h>
+#include <time.h>
+#include <aaudio/AAudio.h>
+#include <gmodule.h>
+
+#include "gstaaudiosink.h"
+#include "gstandroidaudio.h"
+
+GST_DEBUG_CATEGORY_STATIC (aaudio_sink_debug);
+#define GST_CAT_DEFAULT aaudio_sink_debug
+
+/* How long one AAudioStream_write() may wait for room, so that a pause or a
+ * stop is noticed promptly even while the stream is full. */
+#define WRITE_TIMEOUT_NS (10 * GST_MSECOND)
+#define STATE_CHANGE_TIMEOUT_NS (100 * GST_MSECOND)
+
+/* The AAudio entry points, looked up at runtime: the build targets an API
+ * level below AAudio's, and the API 28, 32 and 34 additions are checked for
+ * individually. The optional ones are NULL where the device lacks them. */
+static struct
+{
+  aaudio_result_t (*createStreamBuilder) (AAudioStreamBuilder ** builder);
+  void (*builder_setDirection) (AAudioStreamBuilder * builder,
+      aaudio_direction_t direction);
+  void (*builder_setSharingMode) (AAudioStreamBuilder * builder,
+      aaudio_sharing_mode_t mode);
+  void (*builder_setPerformanceMode) (AAudioStreamBuilder * builder,
+      aaudio_performance_mode_t mode);
+  void (*builder_setFormat) (AAudioStreamBuilder * builder,
+      aaudio_format_t format);
+  void (*builder_setSampleRate) (AAudioStreamBuilder * builder,
+      int32_t rate);
+  void (*builder_setChannelCount) (AAudioStreamBuilder * builder,
+      int32_t channels);
+  void (*builder_setBufferCapacityInFrames) (AAudioStreamBuilder * builder,
+      int32_t frames);
+  void (*builder_setUsage) (AAudioStreamBuilder * builder,
+      aaudio_usage_t usage);
+  void (*builder_setContentType) (AAudioStreamBuilder * builder,
+      aaudio_content_type_t type);
+  void (*builder_setChannelMask) (AAudioStreamBuilder * builder,
+      aaudio_channel_mask_t mask);
+  aaudio_result_t (*builder_openStream) (AAudioStreamBuilder * builder,
+      AAudioStream ** stream);
+  aaudio_result_t (*builder_delete) (AAudioStreamBuilder * builder);
+
+  aaudio_result_t (*stream_close) (AAudioStream * stream);
+  aaudio_result_t (*stream_requestStart) (AAudioStream * stream);
+  aaudio_result_t (*stream_requestPause) (AAudioStream * stream);
+  aaudio_result_t (*stream_requestFlush) (AAudioStream * stream);
+  aaudio_result_t (*stream_waitForStateChange) (AAudioStream * stream,
+      aaudio_stream_state_t input, aaudio_stream_state_t * next,
+      int64_t timeout_ns);
+  aaudio_result_t (*stream_write) (AAudioStream * stream, const void *buffer,
+      int32_t frames, int64_t timeout_ns);
+  aaudio_result_t (*stream_getTimestamp) (AAudioStream * stream,
+      clockid_t clockid, int64_t * frame_position, int64_t * time_ns);
+  int64_t (*stream_getFramesWritten) (AAudioStream * stream);
+  int64_t (*stream_getFramesRead) (AAudioStream * stream);
+  aaudio_stream_state_t (*stream_getState) (AAudioStream * stream);
+  int32_t (*stream_getSampleRate) (AAudioStream * stream);
+  int32_t (*stream_getChannelCount) (AAudioStream * stream);
+  aaudio_format_t (*stream_getFormat) (AAudioStream * stream);
+  int32_t (*stream_getBufferCapacityInFrames) (AAudioStream * stream);
+
+  const char *(*convertResultToText) (aaudio_result_t result);
+} aaudio;
+
+struct _GstAAudioSink
+{
+  GstAudioSink parent;
+
+  gboolean passthrough;
+
+  /* Protects everything below: delay() and pause()/stop() come from other
+   * threads than the writer. */
+  GMutex lock;
+  AAudioStream *stream;
+  gboolean started;
+
+  /* What prepare() asked for, kept to reopen the stream after a
+   * disconnect. */
+  aaudio_format_t format;
+  gint rate;
+  gint channels;
+  aaudio_channel_mask_t channel_mask;
+  gint capacity_frames;
+  /* Bytes per AAudio frame, and per ring buffer frame. They differ only for
+   * E-AC-3, where one ring buffer frame is four IEC 61937 frames. */
+  gint device_bpf;
+  gint ring_bpf;
+};
+
+enum
+{
+  PROP_0,
+  PROP_PASSTHROUGH,
+};
+
+#define DEFAULT_PASSTHROUGH FALSE
+
+#define PCM_FORMATS "{ F32LE, S16LE, S32LE, S24LE }"
+#define PCM_STRUCTURE(n, mask) \
+  "audio/x-raw, format = (string) " PCM_FORMATS ", " \
+  "layout = (string) interleaved, rate = (int) [ 8000, 192000 ], " \
+  "channels = (int) " G_STRINGIFY (n) ", channel-mask = (bitmask) " mask "; "
+
+static GstStaticPadTemplate sink_template = GST_STATIC_PAD_TEMPLATE ("sink",
+    GST_PAD_SINK,
+    GST_PAD_ALWAYS,
+    GST_STATIC_CAPS ("audio/x-raw, format = (string) " PCM_FORMATS ", "
+        "layout = (string) interleaved, rate = (int) [ 8000, 192000 ], "
+        "channels = (int) 1; "
+        PCM_STRUCTURE (2, "0x3")
+        PCM_STRUCTURE (3, "0x7")
+        PCM_STRUCTURE (4, "0x33")
+        PCM_STRUCTURE (4, "0xc03")
+        PCM_STRUCTURE (5, "0x37")
+        PCM_STRUCTURE (5, "0xc07")
+        PCM_STRUCTURE (6, "0x3f")
+        PCM_STRUCTURE (6, "0xc0f")
+        PCM_STRUCTURE (7, "0x13f")
+        PCM_STRUCTURE (8, "0xc3f")
+        "audio/x-ac3, framed = (boolean) true, "
+        "rate = (int) { 32000, 44100, 48000 }; "
+        "audio/x-eac3, framed = (boolean) true, alignment = (string) frame, "
+        "rate = (int) { 32000, 44100, 48000 }; "
+        "audio/x-dts, framed = (boolean) true, "
+        "block-size = (int) { 512, 1024, 2048 }, "
+        "rate = (int) { 32000, 44100, 48000 }"));
+
+#define gst_aaudio_sink_parent_class parent_class
+G_DEFINE_TYPE (GstAAudioSink, gst_aaudio_sink, GST_TYPE_AUDIO_SINK);
+
+static const gchar *
+result_text (aaudio_result_t result)
+{
+  return aaudio.convertResultToText ? aaudio.convertResultToText (result) :
+      "unknown";
+}
+
+static void
+gst_aaudio_sink_set_property (GObject * object, guint prop_id,
+    const GValue * value, GParamSpec * pspec)
+{
+  GstAAudioSink *self = GST_AAUDIO_SINK (object);
+
+  switch (prop_id) {
+    case PROP_PASSTHROUGH:
+      GST_OBJECT_LOCK (self);
+      self->passthrough = g_value_get_boolean (value);
+      GST_OBJECT_UNLOCK (self);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+  }
+}
+
+static void
+gst_aaudio_sink_get_property (GObject * object, guint prop_id,
+    GValue * value, GParamSpec * pspec)
+{
+  GstAAudioSink *self = GST_AAUDIO_SINK (object);
+
+  switch (prop_id) {
+    case PROP_PASSTHROUGH:
+      GST_OBJECT_LOCK (self);
+      g_value_set_boolean (value, self->passthrough);
+      GST_OBJECT_UNLOCK (self);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+  }
+}
+
+static GstCaps *
+gst_aaudio_sink_getcaps (GstBaseSink * bsink, GstCaps * filter)
+{
+  GstAAudioSink *self = GST_AAUDIO_SINK (bsink);
+  static const gchar *formats_31[] = { "F32LE", "S16LE", "S32LE", "S24LE",
+    NULL
+  };
+  static const gchar *formats_26[] = { "F32LE", "S16LE", NULL };
+  gint api = gst_android_audio_get_api_level ();
+  gboolean passthrough;
+  GstCaps *caps, *tmp;
+
+  GST_OBJECT_LOCK (self);
+  passthrough = self->passthrough;
+  GST_OBJECT_UNLOCK (self);
+
+  caps = gst_android_audio_pcm_caps (api >= 31 ? formats_31 : formats_26,
+      aaudio.builder_setChannelMask ? 8 : 2);
+
+  if (passthrough && api >= 34)
+    gst_caps_append (caps,
+        gst_android_audio_passthrough_caps (GST_ANDROID_AUDIO_PASSTHROUGH_ALL));
+
+  if (filter) {
+    tmp = gst_caps_intersect_full (filter, caps, GST_CAPS_INTERSECT_FIRST);
+    gst_caps_unref (caps);
+    caps = tmp;
+  }
+
+  GST_LOG_OBJECT (self, "caps %" GST_PTR_FORMAT, caps);
+
+  return caps;
+}
+
+static gboolean
+gst_aaudio_sink_query (GstBaseSink * bsink, GstQuery * query)
+{
+  if (GST_QUERY_TYPE (query) == GST_QUERY_ACCEPT_CAPS) {
+    GstCaps *caps;
+
+    gst_query_parse_accept_caps (query, &caps);
+    gst_query_set_accept_caps_result (query,
+        gst_android_audio_accept_caps (GST_AUDIO_BASE_SINK (bsink), caps));
+    return TRUE;
+  }
+
+  return GST_BASE_SINK_CLASS (parent_class)->query (bsink, query);
+}
+
+static gboolean
+gst_aaudio_sink_open (GstAudioSink * asink)
+{
+  return TRUE;
+}
+
+static gboolean
+gst_aaudio_sink_close (GstAudioSink * asink)
+{
+  return TRUE;
+}
+
+/* With the lock. */
+static void
+close_stream (GstAAudioSink * self)
+{
+  if (self->stream) {
+    aaudio.stream_close (self->stream);
+    self->stream = NULL;
+  }
+  self->started = FALSE;
+}
+
+/* With the lock. */
+static gboolean
+open_stream (GstAAudioSink * self)
+{
+  AAudioStreamBuilder *builder = NULL;
+  AAudioStream *stream = NULL;
+  aaudio_result_t res;
+
+  res = aaudio.createStreamBuilder (&builder);
+  if (res != AAUDIO_OK) {
+    GST_ERROR_OBJECT (self, "AAudio_createStreamBuilder: %s",
+        result_text (res));
+    return FALSE;
+  }
+
+  aaudio.builder_setDirection (builder, AAUDIO_DIRECTION_OUTPUT);
+  aaudio.builder_setSharingMode (builder, AAUDIO_SHARING_MODE_SHARED);
+  aaudio.builder_setPerformanceMode (builder, AAUDIO_PERFORMANCE_MODE_NONE);
+  aaudio.builder_setFormat (builder, self->format);
+  aaudio.builder_setSampleRate (builder, self->rate);
+  if (self->channel_mask)
+    aaudio.builder_setChannelMask (builder, self->channel_mask);
+  else
+    aaudio.builder_setChannelCount (builder, self->channels);
+  aaudio.builder_setBufferCapacityInFrames (builder, self->capacity_frames);
+  if (aaudio.builder_setUsage)
+    aaudio.builder_setUsage (builder, AAUDIO_USAGE_MEDIA);
+  if (aaudio.builder_setContentType)
+    aaudio.builder_setContentType (builder, AAUDIO_CONTENT_TYPE_MOVIE);
+
+  res = aaudio.builder_openStream (builder, &stream);
+  aaudio.builder_delete (builder);
+  if (res != AAUDIO_OK) {
+    GST_ERROR_OBJECT (self, "AAudioStreamBuilder_openStream (format %d, "
+        "rate %d, channels %d, mask 0x%x): %s", self->format, self->rate,
+        self->channels, self->channel_mask, result_text (res));
+    return FALSE;
+  }
+
+  /* Shared streams are converted by the framework, so anything else here
+   * would mean the data we write is not interpreted the way it is laid
+   * out. */
+  if (aaudio.stream_getFormat (stream) != self->format ||
+      aaudio.stream_getSampleRate (stream) != self->rate ||
+      aaudio.stream_getChannelCount (stream) != self->channels) {
+    GST_ERROR_OBJECT (self, "AAudio opened format %d, rate %d, channels %d, "
+        "instead of format %d, rate %d, channels %d",
+        aaudio.stream_getFormat (stream), aaudio.stream_getSampleRate (stream),
+        aaudio.stream_getChannelCount (stream), self->format, self->rate,
+        self->channels);
+    aaudio.stream_close (stream);
+    return FALSE;
+  }
+
+  GST_INFO_OBJECT (self, "opened stream: format %d, rate %d, channels %d, "
+      "mask 0x%x, capacity %d frames", self->format, self->rate,
+      self->channels, self->channel_mask,
+      aaudio.stream_getBufferCapacityInFrames (stream));
+
+  self->stream = stream;
+  self->started = FALSE;
+
+  return TRUE;
+}
+
+static gboolean
+gst_aaudio_sink_prepare (GstAudioSink * asink, GstAudioRingBufferSpec * spec)
+{
+  GstAAudioSink *self = GST_AAUDIO_SINK (asink);
+  gboolean ret;
+
+  if (gst_android_audio_spec_is_passthrough (spec)) {
+    self->format = AAUDIO_FORMAT_IEC61937;
+    self->rate = gst_android_audio_iec61937_rate (spec);
+    self->channels = 2;
+    self->channel_mask = 0;
+    self->device_bpf = 4;
+  } else {
+    switch (GST_AUDIO_INFO_FORMAT (&spec->info)) {
+      case GST_AUDIO_FORMAT_S16LE:
+        self->format = AAUDIO_FORMAT_PCM_I16;
+        break;
+      case GST_AUDIO_FORMAT_F32LE:
+        self->format = AAUDIO_FORMAT_PCM_FLOAT;
+        break;
+      case GST_AUDIO_FORMAT_S24LE:
+        self->format = AAUDIO_FORMAT_PCM_I24_PACKED;
+        break;
+      case GST_AUDIO_FORMAT_S32LE:
+        self->format = AAUDIO_FORMAT_PCM_I32;
+        break;
+      default:
+        GST_ERROR_OBJECT (self, "unsupported format %s",
+            GST_AUDIO_INFO_NAME (&spec->info));
+        return FALSE;
+    }
+
+    self->rate = GST_AUDIO_INFO_RATE (&spec->info);
+    self->channels = GST_AUDIO_INFO_CHANNELS (&spec->info);
+    self->channel_mask = 0;
+    if (self->channels > 2) {
+      self->channel_mask = gst_android_audio_channel_mask (&spec->info);
+      if (!self->channel_mask || !aaudio.builder_setChannelMask) {
+        GST_ERROR_OBJECT (self, "cannot open %d channels", self->channels);
+        return FALSE;
+      }
+    }
+    self->device_bpf = GST_AUDIO_INFO_BPF (&spec->info);
+  }
+
+  self->ring_bpf = GST_AUDIO_INFO_BPF (&spec->info);
+  self->capacity_frames =
+      gst_util_uint64_scale_int (spec->buffer_time, self->rate, G_USEC_PER_SEC);
+
+  g_mutex_lock (&self->lock);
+  ret = open_stream (self);
+  g_mutex_unlock (&self->lock);
+
+  if (!ret)
+    GST_ELEMENT_ERROR (self, RESOURCE, OPEN_WRITE, (NULL),
+        ("Could not open an AAudio stream"));
+
+  return ret;
+}
+
+static gboolean
+gst_aaudio_sink_unprepare (GstAudioSink * asink)
+{
+  GstAAudioSink *self = GST_AAUDIO_SINK (asink);
+
+  g_mutex_lock (&self->lock);
+  close_stream (self);
+  g_mutex_unlock (&self->lock);
+
+  return TRUE;
+}
+
+static gboolean
+ring_buffer_started (GstAAudioSink * self)
+{
+  GstAudioRingBuffer *buf = GST_AUDIO_BASE_SINK (self)->ringbuffer;
+
+  return g_atomic_int_get (&buf->state) == GST_AUDIO_RING_BUFFER_STATE_STARTED;
+}
+
+/* Writes as much as it can until the ring buffer leaves the started state,
+ * starting the stream first if needed: GstAudioSink has no hook for the
+ * first start, only for resuming. Returns the bytes written, which is 0 once
+ * paused or stopped. */
+static gint
+gst_aaudio_sink_write (GstAudioSink * asink, gpointer data, guint length)
+{
+  GstAAudioSink *self = GST_AAUDIO_SINK (asink);
+  guint8 *ptr = data;
+  gint32 frames = length / self->device_bpf;
+  gint32 done = 0;
+
+  while (done < frames) {
+    AAudioStream *stream;
+    aaudio_result_t res;
+
+    g_mutex_lock (&self->lock);
+    if (!ring_buffer_started (self)) {
+      g_mutex_unlock (&self->lock);
+      break;
+    }
+    if (!self->stream && !open_stream (self)) {
+      g_mutex_unlock (&self->lock);
+      GST_ELEMENT_ERROR (self, RESOURCE, OPEN_WRITE, (NULL),
+          ("Could not reopen the AAudio stream"));
+      return -1;
+    }
+    if (!self->started) {
+      res = aaudio.stream_requestStart (self->stream);
+      if (res != AAUDIO_OK) {
+        g_mutex_unlock (&self->lock);
+        GST_ELEMENT_ERROR (self, RESOURCE, WRITE, (NULL),
+            ("AAudioStream_requestStart: %s", result_text (res)));
+        return -1;
+      }
+      self->started = TRUE;
+    }
+    stream = self->stream;
+    g_mutex_unlock (&self->lock);
+
+    /* Outside the lock: pause and flush may be requested from another
+     * thread meanwhile, which AAudio allows. The stream itself is only
+     * replaced from this thread. */
+    res = aaudio.stream_write (stream, ptr + done * self->device_bpf,
+        frames - done, WRITE_TIMEOUT_NS);
+
+    if (res == AAUDIO_ERROR_DISCONNECTED) {
+      /* The route changed (HDMI replugged, a headset...). Reopen on the
+       * new one and carry on with the data we have. */
+      GST_INFO_OBJECT (self, "stream disconnected, reopening");
+      g_mutex_lock (&self->lock);
+      close_stream (self);
+      g_mutex_unlock (&self->lock);
+      continue;
+    } else if (res < 0) {
+      GST_ELEMENT_ERROR (self, RESOURCE, WRITE, (NULL),
+          ("AAudioStream_write: %s", result_text (res)));
+      return -1;
+    }
+
+    done += res;
+  }
+
+  return done * self->device_bpf;
+}
+
+static guint
+gst_aaudio_sink_delay (GstAudioSink * asink)
+{
+  GstAAudioSink *self = GST_AAUDIO_SINK (asink);
+  gint64 written, played, position, time_ns;
+  gint64 delay = 0;
+
+  g_mutex_lock (&self->lock);
+  if (!self->stream)
+    goto done;
+
+  written = aaudio.stream_getFramesWritten (self->stream);
+
+  if (self->started && aaudio.stream_getTimestamp (self->stream,
+          CLOCK_MONOTONIC, &position, &time_ns) == AAUDIO_OK) {
+    struct timespec now;
+
+    /* The frame presented at time_ns, carried forward to now. */
+    clock_gettime (CLOCK_MONOTONIC, &now);
+    played = position + gst_util_uint64_scale_int (MAX (0,
+            GST_TIMESPEC_TO_TIME (now) - time_ns), self->rate, GST_SECOND);
+  } else {
+    played = aaudio.stream_getFramesRead (self->stream);
+  }
+
+  delay = CLAMP (written - played, 0, written);
+  /* In ring buffer frames. */
+  delay = delay * self->device_bpf / self->ring_bpf;
+
+done:
+  g_mutex_unlock (&self->lock);
+
+  return (guint) delay;
+}
+
+/* With the lock. requestPause() is asynchronous and requestFlush() is only
+ * accepted once it has taken effect. */
+static void
+pause_stream (GstAAudioSink * self)
+{
+  aaudio_stream_state_t state;
+  aaudio_result_t res;
+
+  if (!self->started)
+    return;
+
+  res = aaudio.stream_requestPause (self->stream);
+  if (res != AAUDIO_OK)
+    GST_WARNING_OBJECT (self, "AAudioStream_requestPause: %s",
+        result_text (res));
+  else
+    aaudio.stream_waitForStateChange (self->stream,
+        AAUDIO_STREAM_STATE_PAUSING, &state, STATE_CHANGE_TIMEOUT_NS);
+
+  self->started = FALSE;
+}
+
+static void
+gst_aaudio_sink_pause (GstAudioSink * asink)
+{
+  GstAAudioSink *self = GST_AAUDIO_SINK (asink);
+
+  g_mutex_lock (&self->lock);
+  if (self->stream)
+    pause_stream (self);
+  g_mutex_unlock (&self->lock);
+}
+
+static void
+gst_aaudio_sink_stop (GstAudioSink * asink)
+{
+  GstAAudioSink *self = GST_AAUDIO_SINK (asink);
+  aaudio_result_t res;
+
+  g_mutex_lock (&self->lock);
+  if (self->stream) {
+    pause_stream (self);
+    res = aaudio.stream_requestFlush (self->stream);
+    if (res != AAUDIO_OK)
+      GST_WARNING_OBJECT (self, "AAudioStream_requestFlush: %s",
+          result_text (res));
+  }
+  g_mutex_unlock (&self->lock);
+}
+
+static void
+gst_aaudio_sink_finalize (GObject * object)
+{
+  GstAAudioSink *self = GST_AAUDIO_SINK (object);
+
+  g_mutex_clear (&self->lock);
+
+  G_OBJECT_CLASS (parent_class)->finalize (object);
+}
+
+static void
+gst_aaudio_sink_class_init (GstAAudioSinkClass * klass)
+{
+  GObjectClass *gobject_class = G_OBJECT_CLASS (klass);
+  GstElementClass *element_class = GST_ELEMENT_CLASS (klass);
+  GstBaseSinkClass *basesink_class = GST_BASE_SINK_CLASS (klass);
+  GstAudioBaseSinkClass *audiobasesink_class = GST_AUDIO_BASE_SINK_CLASS (klass);
+  GstAudioSinkClass *audiosink_class = GST_AUDIO_SINK_CLASS (klass);
+
+  gobject_class->set_property = gst_aaudio_sink_set_property;
+  gobject_class->get_property = gst_aaudio_sink_get_property;
+  gobject_class->finalize = gst_aaudio_sink_finalize;
+
+  /**
+   * GstAAudioSink:passthrough:
+   *
+   * Offer AC-3, E-AC-3 and DTS caps and send them as IEC 61937. Has an
+   * effect from API 34 on. AAudio cannot tell whether the output takes
+   * them, so only set this when the sink is known to.
+   */
+  g_object_class_install_property (gobject_class, PROP_PASSTHROUGH,
+      g_param_spec_boolean ("passthrough", "Passthrough",
+          "Offer AC-3, E-AC-3 and DTS for IEC 61937 passthrough (API 34+)",
+          DEFAULT_PASSTHROUGH, G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS));
+
+  gst_element_class_add_static_pad_template (element_class, &sink_template);
+  gst_element_class_set_static_metadata (element_class, "AAudio Sink",
+      "Sink/Audio", "Output audio through AAudio",
+      "BuzzTV <max@buzztv.com>");
+
+  basesink_class->get_caps = GST_DEBUG_FUNCPTR (gst_aaudio_sink_getcaps);
+  basesink_class->query = GST_DEBUG_FUNCPTR (gst_aaudio_sink_query);
+
+  audiobasesink_class->payload = GST_DEBUG_FUNCPTR (gst_android_audio_payload);
+
+  audiosink_class->open = GST_DEBUG_FUNCPTR (gst_aaudio_sink_open);
+  audiosink_class->prepare = GST_DEBUG_FUNCPTR (gst_aaudio_sink_prepare);
+  audiosink_class->unprepare = GST_DEBUG_FUNCPTR (gst_aaudio_sink_unprepare);
+  audiosink_class->close = GST_DEBUG_FUNCPTR (gst_aaudio_sink_close);
+  audiosink_class->write = GST_DEBUG_FUNCPTR (gst_aaudio_sink_write);
+  audiosink_class->delay = GST_DEBUG_FUNCPTR (gst_aaudio_sink_delay);
+  audiosink_class->pause = GST_DEBUG_FUNCPTR (gst_aaudio_sink_pause);
+  audiosink_class->stop = GST_DEBUG_FUNCPTR (gst_aaudio_sink_stop);
+}
+
+static void
+gst_aaudio_sink_init (GstAAudioSink * self)
+{
+  g_mutex_init (&self->lock);
+  self->passthrough = DEFAULT_PASSTHROUGH;
+}
+
+static gboolean
+load_aaudio (void)
+{
+  GModule *lib = g_module_open ("libaaudio.so", G_MODULE_BIND_LOCAL);
+
+  if (!lib) {
+    GST_INFO ("no libaaudio: %s", g_module_error ());
+    return FALSE;
+  }
+
+#define REQUIRED(field, symbol) \
+  G_STMT_START { \
+    if (!g_module_symbol (lib, symbol, (gpointer *) &aaudio.field)) { \
+      GST_WARNING ("libaaudio has no %s", symbol); \
+      goto fail; \
+    } \
+  } G_STMT_END
+#define OPTIONAL(field, symbol) \
+  g_module_symbol (lib, symbol, (gpointer *) &aaudio.field)
+
+  REQUIRED (createStreamBuilder, "AAudio_createStreamBuilder");
+  REQUIRED (builder_setDirection, "AAudioStreamBuilder_setDirection");
+  REQUIRED (builder_setSharingMode, "AAudioStreamBuilder_setSharingMode");
+  REQUIRED (builder_setPerformanceMode,
+      "AAudioStreamBuilder_setPerformanceMode");
+  REQUIRED (builder_setFormat, "AAudioStreamBuilder_setFormat");
+  REQUIRED (builder_setSampleRate, "AAudioStreamBuilder_setSampleRate");
+  REQUIRED (builder_setChannelCount, "AAudioStreamBuilder_setChannelCount");
+  REQUIRED (builder_setBufferCapacityInFrames,
+      "AAudioStreamBuilder_setBufferCapacityInFrames");
+  REQUIRED (builder_openStream, "AAudioStreamBuilder_openStream");
+  REQUIRED (builder_delete, "AAudioStreamBuilder_delete");
+  REQUIRED (stream_close, "AAudioStream_close");
+  REQUIRED (stream_requestStart, "AAudioStream_requestStart");
+  REQUIRED (stream_requestPause, "AAudioStream_requestPause");
+  REQUIRED (stream_requestFlush, "AAudioStream_requestFlush");
+  REQUIRED (stream_waitForStateChange, "AAudioStream_waitForStateChange");
+  REQUIRED (stream_write, "AAudioStream_write");
+  REQUIRED (stream_getTimestamp, "AAudioStream_getTimestamp");
+  REQUIRED (stream_getFramesWritten, "AAudioStream_getFramesWritten");
+  REQUIRED (stream_getFramesRead, "AAudioStream_getFramesRead");
+  REQUIRED (stream_getState, "AAudioStream_getState");
+  REQUIRED (stream_getSampleRate, "AAudioStream_getSampleRate");
+  REQUIRED (stream_getChannelCount, "AAudioStream_getChannelCount");
+  REQUIRED (stream_getFormat, "AAudioStream_getFormat");
+  REQUIRED (stream_getBufferCapacityInFrames,
+      "AAudioStream_getBufferCapacityInFrames");
+  OPTIONAL (convertResultToText, "AAudio_convertResultToText");
+  /* API 28 */
+  OPTIONAL (builder_setUsage, "AAudioStreamBuilder_setUsage");
+  OPTIONAL (builder_setContentType, "AAudioStreamBuilder_setContentType");
+  /* API 32 */
+  OPTIONAL (builder_setChannelMask, "AAudioStreamBuilder_setChannelMask");
+
+#undef REQUIRED
+#undef OPTIONAL
+
+  /* libaaudio stays loaded for the life of the process. */
+  g_module_make_resident (lib);
+  return TRUE;
+
+fail:
+  g_module_close (lib);
+  memset (&aaudio, 0, sizeof (aaudio));
+  return FALSE;
+}
+
+gboolean
+gst_aaudio_sink_register (GstPlugin * plugin)
+{
+  GST_DEBUG_CATEGORY_INIT (aaudio_sink_debug, "aaudiosink", 0,
+      "AAudio sink");
+
+  if (!load_aaudio ())
+    return FALSE;
+
+  GST_INFO ("AAudio on API %d, channel masks %s",
+      gst_android_audio_get_api_level (),
+      aaudio.builder_setChannelMask ? "available" : "not available");
+
+  return gst_element_register (plugin, "aaudiosink", GST_RANK_NONE,
+      GST_TYPE_AAUDIO_SINK);
+}
