+#define gst_audio_track_sink_parent_class parent_class
+G_DEFINE_TYPE (GstAudioTrackSink, gst_audio_track_sink, GST_TYPE_AUDIO_SINK);
+
+static GstClockTime
+monotonic_time (void)
+{
+  struct timespec now;
+
+  clock_gettime (CLOCK_MONOTONIC, &now);
+  return GST_TIMESPEC_TO_TIME (now);
+}
+
+/* JNI thread */
+
+static gpointer
+worker_func (gpointer user_data)
+{
+  GstAudioTrackSink *self = user_data;
+  JNIEnv *env = gst_amc_jni_get_env ();
+
+  while (TRUE) {
+    Job *job = g_async_queue_pop (self->jobs);
+    gboolean quit = job->func == NULL;
+
+    if (!quit)
+      job->func (self, env, job->data);
+
+    g_mutex_lock (&self->job_lock);
+    job->done = TRUE;
+    g_cond_broadcast (&self->job_cond);
+    g_mutex_unlock (&self->job_lock);
+
+    if (quit)
+      break;
+  }
+
+  /* gstjniutils detaches the thread when it exits. */
+  return NULL;
+}
+
+/* Runs @func on the JNI thread and waits for it. */
+static void
+invoke (GstAudioTrackSink * self, JobFunc func, gpointer data)
+{
+  Job job = { func, data, FALSE };
+
+  /* open() failed, or close() already ran */
+  if (!self->worker) {
+    GST_WARNING_OBJECT (self, "no JNI thread");
+    return;
+  }
+
+  if (g_thread_self () == self->worker) {
+    func (self, gst_amc_jni_get_env (), data);
+    return;
+  }
+
+  g_async_queue_push (self->jobs, &job);
+
+  g_mutex_lock (&self->job_lock);
+  while (!job.done)
+    g_cond_wait (&self->job_cond, &self->job_lock);
+  g_mutex_unlock (&self->job_lock);
+}
+
+static gboolean
+start_worker (GstAudioTrackSink * self)
+{
+  GError *err = NULL;
+
+  self->jobs = g_async_queue_new ();
+  self->worker = g_thread_try_new ("audiotrack-jni", worker_func, self, &err);
+  if (!self->worker) {
+    GST_ERROR_OBJECT (self, "could not start the JNI thread: %s",
+        err->message);
+    g_clear_error (&err);
+    g_clear_pointer (&self->jobs, g_async_queue_unref);
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+static void
+stop_worker (GstAudioTrackSink * self)
+{
+  if (!self->worker)
+    return;
+
+  invoke (self, NULL, NULL);
+  g_thread_join (self->worker);
+  self->worker = NULL;
+  g_clear_pointer (&self->jobs, g_async_queue_unref);
+}
+
+static gboolean
+init_jni (JNIEnv * env, GError ** err)
+{
+  static GMutex init_lock;
+  static gboolean initialized = FALSE, ok = FALSE;
+
+  g_mutex_lock (&init_lock);
+  if (initialized)
+    goto done;
+  initialized = TRUE;
+
+#define CLASS(field, name) \
+  if (!(jni.field = gst_amc_jni_get_class (env, err, name))) goto done
+#define METHOD(field, klass, name, sig) \
+  if (!(jni.field = gst_amc_jni_get_method_id (env, err, jni.klass, name, sig))) goto done
+#define STATIC_METHOD(field, klass, name, sig) \
+  if (!(jni.field = gst_amc_jni_get_static_method_id (env, err, jni.klass, name, sig))) goto done
+
+  CLASS (track, "android/media/AudioTrack");
+  CLASS (track_builder, "android/media/AudioTrack$Builder");
+  CLASS (format_builder, "android/media/AudioFormat$Builder");
+  CLASS (attributes_builder, "android/media/AudioAttributes$Builder");
+  CLASS (timestamp, "android/media/AudioTimestamp");
+
+  METHOD (track_play, track, "play", "()V");
+  METHOD (track_pause, track, "pause", "()V");
+  METHOD (track_flush, track, "flush", "()V");
+  METHOD (track_release, track, "release", "()V");
+  METHOD (track_write_buffer, track, "write", "(Ljava/nio/ByteBuffer;II)I");
+  METHOD (track_write_shorts, track, "write", "([SIII)I");
+  METHOD (track_get_playback_head_position, track, "getPlaybackHeadPosition",
+      "()I");
+  METHOD (track_get_timestamp, track, "getTimestamp",
+      "(Landroid/media/AudioTimestamp;)Z");
+  METHOD (track_get_state, track, "getState", "()I");
+  STATIC_METHOD (track_get_min_buffer_size, track, "getMinBufferSize",
+      "(III)I");
+
+  METHOD (track_builder_ctor, track_builder, "<init>", "()V");
+  METHOD (track_builder_set_audio_attributes, track_builder,
+      "setAudioAttributes",
+      "(Landroid/media/AudioAttributes;)Landroid/media/AudioTrack$Builder;");
+  METHOD (track_builder_set_audio_format, track_builder, "setAudioFormat",
+      "(Landroid/media/AudioFormat;)Landroid/media/AudioTrack$Builder;");
+  METHOD (track_builder_set_buffer_size, track_builder,
+      "setBufferSizeInBytes", "(I)Landroid/media/AudioTrack$Builder;");
+  METHOD (track_builder_set_transfer_mode, track_builder, "setTransferMode",
+      "(I)Landroid/media/AudioTrack$Builder;");
+  METHOD (track_builder_build, track_builder, "build",
+      "()Landroid/media/AudioTrack;");
+
+  METHOD (format_builder_ctor, format_builder, "<init>", "()V");
+  METHOD (format_builder_set_encoding, format_builder, "setEncoding",
+      "(I)Landroid/media/AudioFormat$Builder;");
+  METHOD (format_builder_set_sample_rate, format_builder, "setSampleRate",
+      "(I)Landroid/media/AudioFormat$Builder;");
+  METHOD (format_builder_set_channel_mask, format_builder, "setChannelMask",
+      "(I)Landroid/media/AudioFormat$Builder;");
+  METHOD (format_builder_build, format_builder, "build",
+      "()Landroid/media/AudioFormat;");
+
+  METHOD (attributes_builder_ctor, attributes_builder, "<init>", "()V");
+  METHOD (attributes_builder_set_usage, attributes_builder, "setUsage",
+      "(I)Landroid/media/AudioAttributes$Builder;");
+  METHOD (attributes_builder_set_content_type, attributes_builder,
+      "setContentType", "(I)Landroid/media/AudioAttributes$Builder;");
+  METHOD (attributes_builder_build, attributes_builder, "build",
+      "()Landroid/media/AudioAttributes;");
+
+  METHOD (timestamp_ctor, timestamp, "<init>", "()V");
+  if (!(jni.timestamp_frame_position = gst_amc_jni_get_field_id (env, err,
+              jni.timestamp, "framePosition", "J")))
+    goto done;
+  if (!(jni.timestamp_nano_time = gst_amc_jni_get_field_id (env, err,
+              jni.timestamp, "nanoTime", "J")))
+    goto done;
+
+  if (gst_android_audio_get_api_level () >= 29)
+    STATIC_METHOD (track_is_direct_playback_supported, track,
+        "isDirectPlaybackSupported",
+        "(Landroid/media/AudioFormat;Landroid/media/AudioAttributes;)Z");
+
+#undef CLASS
+#undef METHOD
+#undef STATIC_METHOD
+
+  ok = TRUE;
+
+done:
+  if (!ok && err && !*err)
+    g_set_error (err, GST_LIBRARY_ERROR, GST_LIBRARY_ERROR_INIT,
+        "AudioTrack JNI initialization failed earlier");
