+  return ok;
+}
+
+/* Calls a Builder setter taking an int or an object, dropping the builder
+ * reference it returns. */
+static gboolean
+builder_set_int (JNIEnv * env, GError ** err, jobject builder,
+    jmethodID method, gint value)
+{
+  jobject ret = NULL;
+
+  if (!gst_amc_jni_call_object_method (env, err, builder, method, &ret,
+          (jint) value))
+    return FALSE;
+  gst_amc_jni_object_local_unref (env, ret);
+  return TRUE;
+}
+
+static gboolean
+builder_set_object (JNIEnv * env, GError ** err, jobject builder,
+    jmethodID method, jobject value)
+{
+  jobject ret = NULL;
+
+  if (!gst_amc_jni_call_object_method (env, err, builder, method, &ret, value))
+    return FALSE;
+  gst_amc_jni_object_local_unref (env, ret);
+  return TRUE;
+}
+
+/* Local reference, or NULL */
+static jobject
+build_attributes (JNIEnv * env, GError ** err)
+{
+  jobject builder, attributes = NULL;
+
+  builder = gst_amc_jni_new_object (env, err, FALSE, jni.attributes_builder,
+      jni.attributes_builder_ctor);
+  if (!builder)
+    return NULL;
+
+  if (builder_set_int (env, err, builder, jni.attributes_builder_set_usage,
+          USAGE_MEDIA) &&
+      builder_set_int (env, err, builder,
+          jni.attributes_builder_set_content_type, CONTENT_TYPE_MOVIE))
+    gst_amc_jni_call_object_method (env, err, builder,
+        jni.attributes_builder_build, &attributes);
+
+  gst_amc_jni_object_local_unref (env, builder);
+  return attributes;
+}
+
+/* Local reference, or NULL */
+static jobject
+build_format (JNIEnv * env, GError ** err, gint encoding, gint rate,
+    gint channel_mask)
+{
+  jobject builder, format = NULL;
+
+  builder = gst_amc_jni_new_object (env, err, FALSE, jni.format_builder,
+      jni.format_builder_ctor);
+  if (!builder)
+    return NULL;
+
+  if (builder_set_int (env, err, builder, jni.format_builder_set_encoding,
+          encoding) &&
+      builder_set_int (env, err, builder, jni.format_builder_set_sample_rate,
+          rate) &&
+      builder_set_int (env, err, builder, jni.format_builder_set_channel_mask,
+          channel_mask))
+    gst_amc_jni_call_object_method (env, err, builder,
+        jni.format_builder_build, &format);
+
+  gst_amc_jni_object_local_unref (env, builder);
+  return format;
+}
+
+static void
+log_error (GstAudioTrackSink * self, const gchar * what, GError ** err)
+{
+  GST_ERROR_OBJECT (self, "%s: %s", what, *err ? (*err)->message : "failed");
+  g_clear_error (err);
+}
+
+/* Which passthrough codecs to offer. isDirectPlaybackSupported() is asked
+ * about each codec's own encoding, which is what reflects the capabilities
+ * of the sink at the end of the HDMI link; they are then sent as IEC 61937
+ * regardless, as mpv does on the same devices. */
+static guint
+probe_passthrough (GstAudioTrackSink * self, JNIEnv * env)
+{
+  static const struct
+  {
+    gint encoding;
+    guint flag;
+    const gchar *name;
+  } codecs[] = {
+    {ENCODING_AC3, GST_ANDROID_AUDIO_PASSTHROUGH_AC3, "AC-3"},
+    {ENCODING_E_AC3, GST_ANDROID_AUDIO_PASSTHROUGH_EAC3, "E-AC-3"},
+    {ENCODING_DTS, GST_ANDROID_AUDIO_PASSTHROUGH_DTS, "DTS"},
+  };
+  GError *err = NULL;
+  jobject attributes;
+  guint supported = 0, i;
+
+  if (!jni.track_is_direct_playback_supported) {
+    GST_INFO_OBJECT (self, "API %d cannot report passthrough support, "
+        "offering all codecs", gst_android_audio_get_api_level ());
+    return GST_ANDROID_AUDIO_PASSTHROUGH_ALL;
+  }
+
+  attributes = build_attributes (env, &err);
+  if (!attributes) {
+    log_error (self, "AudioAttributes", &err);
+    return 0;
+  }
+
+  for (i = 0; i < G_N_ELEMENTS (codecs); i++) {
+    jobject format = build_format (env, &err, codecs[i].encoding, 48000,
+        CHANNEL_OUT_STEREO);
+    gboolean direct = FALSE;
+
+    if (!format) {
+      log_error (self, "AudioFormat", &err);
+      continue;
+    }
+
+    if (!gst_amc_jni_call_static_boolean_method (env, &err, jni.track,
+            jni.track_is_direct_playback_supported, &direct, format,
+            attributes))
+      log_error (self, "isDirectPlaybackSupported", &err);
+
+    GST_INFO_OBJECT (self, "%s passthrough %ssupported", codecs[i].name,
+        direct ? "" : "not ");
+    if (direct)
+      supported |= codecs[i].flag;
+
+    gst_amc_jni_object_local_unref (env, format);
+  }
+
+  gst_amc_jni_object_local_unref (env, attributes);
+  return supported;
+}
+
+static void
+job_open (GstAudioTrackSink * self, JNIEnv * env, gpointer data)
+{
+  gboolean *ret = data;
+  GError *err = NULL;
+  gboolean passthrough;
+  guint supported = 0;
+
+  if (!env || !init_jni (env, &err)) {
+    log_error (self, "JNI", &err);
+    *ret = FALSE;
+    return;
+  }
+
+  GST_OBJECT_LOCK (self);
+  passthrough = self->passthrough;
+  GST_OBJECT_UNLOCK (self);
+
+  if (passthrough)
+    supported = probe_passthrough (self, env);
+
+  GST_OBJECT_LOCK (self);
+  self->supported_passthrough = supported;
+  GST_OBJECT_UNLOCK (self);
+
+  *ret = TRUE;
+}
+
+static void
+reset_position (GstAudioTrackSink * self)
+{
+  self->head_position = 0;
+  self->frames_written = 0;
+
+  g_mutex_lock (&self->lock);
+  self->position_valid = FALSE;
+  self->position_playing = FALSE;
+  self->position_written = 0;
+  self->position_played = 0;
+  g_mutex_unlock (&self->lock);
+}
+
+static void
+job_release (GstAudioTrackSink * self, JNIEnv * env, gpointer data)
+{
+  GError *err = NULL;
+
+  if (self->track) {
+    if (!gst_amc_jni_call_void_method (env, &err, self->track,
+            jni.track_release))
+      log_error (self, "AudioTrack.release", &err);
+    gst_amc_jni_object_unref (env, self->track);
+    self->track = NULL;
+  }
+  if (self->timestamp) {
+    gst_amc_jni_object_unref (env, self->timestamp);
+    self->timestamp = NULL;
+  }
+  if (self->shorts) {
+    gst_amc_jni_object_unref (env, self->shorts);
+    self->shorts = NULL;
+    self->shorts_len = 0;
+  }
+
+  self->playing = FALSE;
+  reset_position (self);
+}
+
+static void
+job_create (GstAudioTrackSink * self, JNIEnv * env, gpointer data)
+{
+  gboolean *ret = data;
+  GError *err = NULL;
+  jobject attributes = NULL, format = NULL, builder = NULL, track = NULL;
+  gint min_size = 0, size, state = 0;
+
+  *ret = FALSE;
+
+  job_release (self, env, NULL);
+
+  if (!gst_amc_jni_call_static_int_method (env, &err, jni.track,
+          jni.track_get_min_buffer_size, &min_size, self->rate,
+          self->channel_mask, self->encoding) || min_size <= 0) {
+    GST_ERROR_OBJECT (self, "AudioTrack.getMinBufferSize (%d, 0x%x, %d) = %d",
+        self->rate, self->channel_mask, self->encoding, min_size);
+    g_clear_error (&err);
+    return;
+  }
+
+  /* At least 100 ms, in whole frames: the ring buffer upstream holds the
+   * rest. */
+  size = MAX (min_size, self->rate / 10 * self->device_bpf);
+  size = GST_ROUND_UP_N (size, self->device_bpf);
+
+  attributes = build_attributes (env, &err);
+  if (!attributes)
+    goto fail;
+  format = build_format (env, &err, self->encoding, self->rate,
+      self->channel_mask);
+  if (!format)
+    goto fail;
+
+  builder = gst_amc_jni_new_object (env, &err, FALSE, jni.track_builder,
+      jni.track_builder_ctor);
+  if (!builder)
+    goto fail;
+
+  if (!builder_set_object (env, &err, builder,
+          jni.track_builder_set_audio_attributes, attributes) ||
+      !builder_set_object (env, &err, builder,
+          jni.track_builder_set_audio_format, format) ||
+      !builder_set_int (env, &err, builder,
+          jni.track_builder_set_buffer_size, size) ||
+      !builder_set_int (env, &err, builder,
+          jni.track_builder_set_transfer_mode, MODE_STREAM))
+    goto fail;
+
+  /* Throws UnsupportedOperationException for a format the output refuses. */
+  if (!gst_amc_jni_call_object_method (env, &err, builder,
+          jni.track_builder_build, &track))
+    goto fail;
+
+  if (!gst_amc_jni_call_int_method (env, &err, track, jni.track_get_state,
+          &state) || state != STATE_INITIALIZED) {
+    GST_ERROR_OBJECT (self, "AudioTrack state %d", state);
+    gst_amc_jni_call_void_method (env, NULL, track, jni.track_release);
+    goto fail;
+  }
+
+  self->timestamp = gst_amc_jni_new_object (env, &err, TRUE, jni.timestamp,
+      jni.timestamp_ctor);
+  if (!self->timestamp) {
+    gst_amc_jni_call_void_method (env, NULL, track, jni.track_release);
+    goto fail;
+  }
+
+  self->track = gst_amc_jni_object_make_global (env, track);
+  track = NULL;
+
+  GST_INFO_OBJECT (self, "created AudioTrack: encoding %d, rate %d, "
+      "mask 0x%x, buffer %d bytes (min %d)", self->encoding, self->rate,
+      self->channel_mask, size, min_size);
+
+  *ret = TRUE;
+  goto done;
+
+fail:
+  GST_ERROR_OBJECT (self, "could not create an AudioTrack (encoding %d, "
+      "rate %d, mask 0x%x): %s", self->encoding, self->rate,
+      self->channel_mask, err ? err->message : "failed");
+  g_clear_error (&err);
+
+done:
+  if (track)
+    gst_amc_jni_object_local_unref (env, track);
+  if (builder)
+    gst_amc_jni_object_local_unref (env, builder);
+  if (format)
+    gst_amc_jni_object_local_unref (env, format);
+  if (attributes)
+    gst_amc_jni_object_local_unref (env, attributes);
+}
+
+/* Where playback is, from the presentation timestamp when there is a recent
+ * one, otherwise from the playback head. */
+static void
+update_position (GstAudioTrackSink * self, JNIEnv * env)
+{
+  GstClockTime now = monotonic_time ();
+  gboolean have_timestamp = FALSE;
+  gint64 played = 0;
+  gint head = 0;
+
+  if (gst_amc_jni_call_boolean_method (env, NULL, self->track,
+          jni.track_get_timestamp, &have_timestamp, self->timestamp) &&
+      have_timestamp) {
+    jlong position = (*env)->GetLongField (env, self->timestamp,
+        jni.timestamp_frame_position);
+    jlong time = (*env)->GetLongField (env, self->timestamp,
+        jni.timestamp_nano_time);
+
+    if (position > 0 && time <= now && now - time < TIMESTAMP_MAX_AGE)
+      played = position + gst_util_uint64_scale_int (now - time, self->rate,
+          GST_SECOND);
+    else
+      have_timestamp = FALSE;
+  }
+
+  if (!have_timestamp) {
+    if (!gst_amc_jni_call_int_method (env, NULL, self->track,
+            jni.track_get_playback_head_position, &head))
+      return;
+
+    /* A 32-bit unsigned count that wraps around. */
+    if ((guint32) head < (guint32) self->head_position)
+      self->head_position += G_GUINT64_CONSTANT (1) << 32;
+    self->head_position = (self->head_position & ~G_GUINT64_CONSTANT
+        (0xffffffff)) | (guint32) head;
+    played = self->head_position;
+  }
+
+  g_mutex_lock (&self->lock);
+  self->position_valid = TRUE;
+  self->position_playing = self->playing;
+  self->position_written = self->frames_written;
+  self->position_played = played;
+  self->position_time = now;
+  g_mutex_unlock (&self->lock);
+}
+
+static gboolean
+ring_buffer_started (GstAudioTrackSink * self)
+{
+  GstAudioRingBuffer *buf = GST_AUDIO_BASE_SINK (self)->ringbuffer;
+
+  return g_atomic_int_get (&buf->state) == GST_AUDIO_RING_BUFFER_STATE_STARTED;
+}
+
+typedef struct
+{
+  const guint8 *data;
+  gint length;
+  gint result;
+} WriteJob;
+
+/* Offers the data to the track without blocking, starting it first if
+ * needed. The ring buffer state is checked here, on the JNI thread, so that
+ * a pause queued behind this job cannot be undone by it. */
+static void
+job_write (GstAudioTrackSink * self, JNIEnv * env, gpointer data)
+{
+  WriteJob *job = data;
+  GError *err = NULL;
+  gint ret = 0;
+
+  job->result = 0;
+
+  if (!ring_buffer_started (self))
+    return;
+
+  if (!self->track) {
+    gboolean created;
+
+    job_create (self, env, &created);
+    if (!created) {
+      job->result = -1;
+      return;
+    }
+  }
+
+  if (!self->playing) {
+    if (!gst_amc_jni_call_void_method (env, &err, self->track,
+            jni.track_play)) {
+      log_error (self, "AudioTrack.play", &err);
+      job->result = -1;
+      return;
+    }
+    self->playing = TRUE;
+  }
+
+  if (self->iec61937) {
+    /* IEC 61937 is written as shorts, as mpv does. */
+    gint n = job->length / 2;
+
+    if (n > self->shorts_len) {
+      jshortArray array = (*env)->NewShortArray (env, n);
+
+      if (!array) {
+        (*env)->ExceptionClear (env);
+        job->result = -1;
+        return;
+      }
+      if (self->shorts)
+        gst_amc_jni_object_unref (env, self->shorts);
+      self->shorts = gst_amc_jni_object_make_global (env, array);
+      self->shorts_len = n;
+    }
+
+    (*env)->SetShortArrayRegion (env, self->shorts, 0, n,
+        (const jshort *) job->data);
+    if (gst_amc_jni_call_int_method (env, &err, self->track,
+            jni.track_write_shorts, &ret, self->shorts, 0, n,
+            WRITE_NON_BLOCKING) && ret > 0)
+      ret *= 2;
+  } else {
+    jobject buffer = (*env)->NewDirectByteBuffer (env, (void *) job->data,
+        job->length);
+
+    if (!buffer) {
+      (*env)->ExceptionClear (env);
+      job->result = -1;
+      return;
+    }
+    gst_amc_jni_call_int_method (env, &err, self->track,
+        jni.track_write_buffer, &ret, buffer, job->length, WRITE_NON_BLOCKING);
+    gst_amc_jni_object_local_unref (env, buffer);
+  }
+
+  if (err) {
+    log_error (self, "AudioTrack.write", &err);
+    job->result = -1;
+    return;
+  }
+
+  if (ret == ERROR_DEAD_OBJECT) {
+    /* The output went away (HDMI replugged, audioserver restarted). The
+     * next write creates a new track on the current route. */
+    GST_INFO_OBJECT (self, "AudioTrack is dead, recreating it");
+    job_release (self, env, NULL);
+    return;
+  } else if (ret < 0) {
+    GST_ERROR_OBJECT (self, "AudioTrack.write: %d", ret);
+    job->result = -1;
+    return;
+  }
+
+  self->frames_written += ret / self->device_bpf;
+  update_position (self, env);
+
+  job->result = ret;
+}
+
+static void
+job_pause (GstAudioTrackSink * self, JNIEnv * env, gpointer data)
+{
+  GError *err = NULL;
+
+  if (!self->track || !self->playing)
+    return;
+
+  if (!gst_amc_jni_call_void_method (env, &err, self->track, jni.track_pause))
+    log_error (self, "AudioTrack.pause", &err);
+  self->playing = FALSE;
+
+  g_mutex_lock (&self->lock);
+  self->position_playing = FALSE;
+  g_mutex_unlock (&self->lock);
+}
+
+static void
+job_stop (GstAudioTrackSink * self, JNIEnv * env, gpointer data)
+{
+  GError *err = NULL;
+
+  if (!self->track)
+    return;
+
+  job_pause (self, env, NULL);
+  if (!gst_amc_jni_call_void_method (env, &err, self->track, jni.track_flush))
+    log_error (self, "AudioTrack.flush", &err);
+
+  reset_position (self);
+}
+
+/* GstAudioSink */
+
+static gboolean
+gst_audio_track_sink_open (GstAudioSink * asink)
+{
+  GstAudioTrackSink *self = GST_AUDIO_TRACK_SINK (asink);
+  gboolean ret = FALSE;
+
+  if (!start_worker (self))
+    goto fail;
+
+  invoke (self, job_open, &ret);
+  if (!ret) {
+    stop_worker (self);
+    goto fail;
+  }
+
+  return TRUE;
+
+fail:
+  GST_ELEMENT_ERROR (self, RESOURCE, OPEN_WRITE, (NULL),
+      ("Could not initialize AudioTrack"));
+  return FALSE;
+}
+
+static gboolean
+gst_audio_track_sink_close (GstAudioSink * asink)
+{
+  GstAudioTrackSink *self = GST_AUDIO_TRACK_SINK (asink);
+
+  if (self->worker)
+    invoke (self, job_release, NULL);
+  stop_worker (self);
+
+  GST_OBJECT_LOCK (self);
+  self->supported_passthrough = 0;
+  GST_OBJECT_UNLOCK (self);
+
+  return TRUE;
+}
+
+static gboolean
+gst_audio_track_sink_prepare (GstAudioSink * asink,
+    GstAudioRingBufferSpec * spec)
+{
+  GstAudioTrackSink *self = GST_AUDIO_TRACK_SINK (asink);
+  gboolean ret = FALSE;
+
+  if (gst_android_audio_spec_is_passthrough (spec)) {
+    self->iec61937 = TRUE;
+    self->encoding = ENCODING_IEC61937;
+    self->rate = gst_android_audio_iec61937_rate (spec);
+    self->channel_mask = CHANNEL_OUT_STEREO;
+    self->device_bpf = 4;
+  } else {
+    guint32 mask;
+
+    switch (GST_AUDIO_INFO_FORMAT (&spec->info)) {
+      case GST_AUDIO_FORMAT_S16LE:
+        self->encoding = ENCODING_PCM_16BIT;
+        break;
+      case GST_AUDIO_FORMAT_F32LE:
+        self->encoding = ENCODING_PCM_FLOAT;
+        break;
+      case GST_AUDIO_FORMAT_S24LE:
+        self->encoding = ENCODING_PCM_24BIT_PACKED;
+        break;
+      case GST_AUDIO_FORMAT_S32LE:
+        self->encoding = ENCODING_PCM_32BIT;
+        break;
+      default:
+        GST_ERROR_OBJECT (self, "unsupported format %s",
+            GST_AUDIO_INFO_NAME (&spec->info));
+        return FALSE;
+    }
+
+    mask = gst_android_audio_channel_mask (&spec->info);
+    if (!mask) {
+      GST_ERROR_OBJECT (self, "unsupported layout");
+      return FALSE;
+    }
+
+    self->iec61937 = FALSE;
+    self->rate = GST_AUDIO_INFO_RATE (&spec->info);
+    self->channel_mask = GST_ANDROID_AUDIO_JAVA_CHANNEL_MASK (mask);
+    self->device_bpf = GST_AUDIO_INFO_BPF (&spec->info);
+  }
+  self->ring_bpf = GST_AUDIO_INFO_BPF (&spec->info);
+
+  invoke (self, job_create, &ret);
+  if (!ret)
+    GST_ELEMENT_ERROR (self, RESOURCE, OPEN_WRITE, (NULL),
+        ("Could not create an AudioTrack (encoding %d, rate %d, mask 0x%x)",
+            self->encoding, self->rate, self->channel_mask));
+
+  return ret;
+}
+
+static gboolean
+gst_audio_track_sink_unprepare (GstAudioSink * asink)
+{
+  GstAudioTrackSink *self = GST_AUDIO_TRACK_SINK (asink);
+
+  invoke (self, job_release, NULL);
+
+  return TRUE;
+}
+
+static gint
+gst_audio_track_sink_write (GstAudioSink * asink, gpointer data, guint length)
+{
+  GstAudioTrackSink *self = GST_AUDIO_TRACK_SINK (asink);
+  guint done = 0;
+
+  while (done < length) {
+    WriteJob job = { (const guint8 *) data + done, length - done, 0 };
+
+    if (!ring_buffer_started (self))
+      break;
+
+    invoke (self, job_write, &job);
+    if (job.result < 0) {
+      GST_ELEMENT_ERROR (self, RESOURCE, WRITE, (NULL),
+          ("Could not write to the AudioTrack"));
+      return -1;
+    }
+
+    if (job.result == 0)
+      g_usleep (FULL_WAIT_US);
+    done += job.result;
+  }
+
+  return done;
+}
+
+static guint
+gst_audio_track_sink_delay (GstAudioSink * asink)
+{
+  GstAudioTrackSink *self = GST_AUDIO_TRACK_SINK (asink);
+  gint64 played, delay = 0;
+
+  g_mutex_lock (&self->lock);
+  if (self->position_valid) {
+    played = self->position_played;
+    if (self->position_playing)
+      played += gst_util_uint64_scale_int (monotonic_time () -
+          self->position_time, self->rate, GST_SECOND);
+
+    delay = CLAMP (self->position_written - played, 0,
+        self->position_written);
+    /* In ring buffer frames. */
+    delay = delay * self->device_bpf / self->ring_bpf;
+  }
+  g_mutex_unlock (&self->lock);
+
+  return (guint) delay;
+}
+
+static void
+gst_audio_track_sink_pause (GstAudioSink * asink)
+{
+  GstAudioTrackSink *self = GST_AUDIO_TRACK_SINK (asink);
+
+  invoke (self, job_pause, NULL);
+}
+
+static void
+gst_audio_track_sink_stop (GstAudioSink * asink)
+{
+  GstAudioTrackSink *self = GST_AUDIO_TRACK_SINK (asink);
+
+  invoke (self, job_stop, NULL);
+}
+
+/* GstBaseSink */
+
+static GstCaps *
+gst_audio_track_sink_getcaps (GstBaseSink * bsink, GstCaps * filter)
+{
+  GstAudioTrackSink *self = GST_AUDIO_TRACK_SINK (bsink);
+  static const gchar *formats_31[] = { "F32LE", "S16LE", "S32LE", "S24LE",
+    NULL
+  };
+  static const gchar *formats_21[] = { "F32LE", "S16LE", NULL };
+  gboolean passthrough;
+  guint supported;
+  GstCaps *caps, *tmp;
+
+  GST_OBJECT_LOCK (self);
+  passthrough = self->passthrough;
+  supported = self->supported_passthrough;
+  GST_OBJECT_UNLOCK (self);
+
+  caps = gst_android_audio_pcm_caps (gst_android_audio_get_api_level () >= 31
+      ? formats_31 : formats_21, 8);
+
+  /* Only once open() has probed the output. */
+  if (passthrough && supported)
+    gst_caps_append (caps, gst_android_audio_passthrough_caps (supported));
+
+  if (filter) {
+    tmp = gst_caps_intersect_full (filter, caps, GST_CAPS_INTERSECT_FIRST);
+    gst_caps_unref (caps);
+    caps = tmp;
+  }
+
+  GST_LOG_OBJECT (self, "caps %" GST_PTR_FORMAT, caps);
+
+  return caps;
+}
+
+static gboolean
+gst_audio_track_sink_query (GstBaseSink * bsink, GstQuery * query)
+{
+  if (GST_QUERY_TYPE (query) == GST_QUERY_ACCEPT_CAPS) {
+    GstCaps *caps;
+
+    gst_query_parse_accept_caps (query, &caps);
+    gst_query_set_accept_caps_result (query,
+        gst_android_audio_accept_caps (GST_AUDIO_BASE_SINK (bsink), caps));
+    return TRUE;
+  }
+
+  return GST_BASE_SINK_CLASS (parent_class)->query (bsink, query);
+}
+
+/* GObject */
+
+static void
+gst_audio_track_sink_set_property (GObject * object, guint prop_id,
+    const GValue * value, GParamSpec * pspec)
+{
+  GstAudioTrackSink *self = GST_AUDIO_TRACK_SINK (object);
+
+  switch (prop_id) {
+    case PROP_PASSTHROUGH:
+      GST_OBJECT_LOCK (self);
+      self->passthrough = g_value_get_boolean (value);
+      GST_OBJECT_UNLOCK (self);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+  }
+}
+
+static void
+gst_audio_track_sink_get_property (GObject * object, guint prop_id,
+    GValue * value, GParamSpec * pspec)
+{
+  GstAudioTrackSink *self = GST_AUDIO_TRACK_SINK (object);
+
+  switch (prop_id) {
+    case PROP_PASSTHROUGH:
+      GST_OBJECT_LOCK (self);
+      g_value_set_boolean (value, self->passthrough);
+      GST_OBJECT_UNLOCK (self);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+  }
+}
+
+static void
+gst_audio_track_sink_finalize (GObject * object)
+{
+  GstAudioTrackSink *self = GST_AUDIO_TRACK_SINK (object);
+
+  g_mutex_clear (&self->job_lock);
+  g_cond_clear (&self->job_cond);
+  g_mutex_clear (&self->lock);
+
+  G_OBJECT_CLASS (parent_class)->finalize (object);
+}
+
+static void
+gst_audio_track_sink_class_init (GstAudioTrackSinkClass * klass)
+{
+  GObjectClass *gobject_class = G_OBJECT_CLASS (klass);
+  GstElementClass *element_class = GST_ELEMENT_CLASS (klass);
+  GstBaseSinkClass *basesink_class = GST_BASE_SINK_CLASS (klass);
+  GstAudioBaseSinkClass *audiobasesink_class = GST_AUDIO_BASE_SINK_CLASS (klass);
+  GstAudioSinkClass *audiosink_class = GST_AUDIO_SINK_CLASS (klass);
+
+  gobject_class->set_property = gst_audio_track_sink_set_property;
+  gobject_class->get_property = gst_audio_track_sink_get_property;
+  gobject_class->finalize = gst_audio_track_sink_finalize;
+
+  /**
+   * GstAudioTrackSink:passthrough:
+   *
+   * Offer the AC-3, E-AC-3 and DTS caps the output supports and send them
+   * as IEC 61937. Read when the element goes to READY, which is when the
+   * output is probed.
+   */
+  g_object_class_install_property (gobject_class, PROP_PASSTHROUGH,
+      g_param_spec_boolean ("passthrough", "Passthrough",
+          "Offer AC-3, E-AC-3 and DTS for IEC 61937 passthrough",
+          DEFAULT_PASSTHROUGH, G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS));
+
+  gst_element_class_add_static_pad_template (element_class, &sink_template);
+  gst_element_class_set_static_metadata (element_class, "AudioTrack Sink",
+      "Sink/Audio", "Output audio through android.media.AudioTrack",
+      "BuzzTV <max@buzztv.com>");
+
+  basesink_class->get_caps = GST_DEBUG_FUNCPTR (gst_audio_track_sink_getcaps);
+  basesink_class->query = GST_DEBUG_FUNCPTR (gst_audio_track_sink_query);
+
+  audiobasesink_class->payload = GST_DEBUG_FUNCPTR (gst_android_audio_payload);
+
+  audiosink_class->open = GST_DEBUG_FUNCPTR (gst_audio_track_sink_open);
+  audiosink_class->prepare = GST_DEBUG_FUNCPTR (gst_audio_track_sink_prepare);
+  audiosink_class->unprepare =
+      GST_DEBUG_FUNCPTR (gst_audio_track_sink_unprepare);
+  audiosink_class->close = GST_DEBUG_FUNCPTR (gst_audio_track_sink_close);
+  audiosink_class->write = GST_DEBUG_FUNCPTR (gst_audio_track_sink_write);
+  audiosink_class->delay = GST_DEBUG_FUNCPTR (gst_audio_track_sink_delay);
+  audiosink_class->pause = GST_DEBUG_FUNCPTR (gst_audio_track_sink_pause);
+  audiosink_class->stop = GST_DEBUG_FUNCPTR (gst_audio_track_sink_stop);
+}
+
+static void
+gst_audio_track_sink_init (GstAudioTrackSink * self)
+{
+  g_mutex_init (&self->job_lock);
+  g_cond_init (&self->job_cond);
+  g_mutex_init (&self->lock);
+  self->passthrough = DEFAULT_PASSTHROUGH;
+}
+
+gboolean
+gst_audio_track_sink_register (GstPlugin * plugin)
+{
+  GST_DEBUG_CATEGORY_INIT (audio_track_sink_debug, "audiotracksink", 0,
+      "AudioTrack sink");
+
+  /* AudioTrack.Builder */
+  if (gst_android_audio_get_api_level () < 23)
+    return FALSE;
+
+  return gst_element_register (plugin, "audiotracksink", GST_RANK_NONE,
+      GST_TYPE_AUDIO_TRACK_SINK);
+}
