+#define CHANNEL_OUT_STEREO 12
+#define USAGE_MEDIA 1
+#define CONTENT_TYPE_MOVIE 3
+#define MODE_STREAM 1
+#define STATE_INITIALIZED 1
+#define WRITE_NON_BLOCKING 1
+#define ERROR_DEAD_OBJECT (-6)
