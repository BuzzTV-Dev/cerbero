+        PCM_STRUCTURE (3, "0x7")
+        PCM_STRUCTURE (4, "0x33")
+        PCM_STRUCTURE (4, "0xc03")
+        PCM_STRUCTURE (5, "0x37")
+        PCM_STRUCTURE (5, "0xc07")
+        PCM_STRUCTURE (6, "0x3f")
+        PCM_STRUCTURE (6, "0xc0f")
+        PCM_STRUCTURE (7, "0x13f")
+        PCM_STRUCTURE (8, "0xc3f")
+        "audio/x-ac3, framed = (boolean) true, "
+        "rate = (int) { 32000, 44100, 48000 }; "
+        "audio/x-eac3, framed = (boolean) true, alignment = (string) frame, "
+        "rate = (int) { 32000, 44100, 48000 }; "
+        "audio/x-dts, framed = (boolean) true, "
+        "block-size = (int) { 512, 1024, 2048 }, "
+        "rate = (int) { 32000, 44100, 48000 }"));
