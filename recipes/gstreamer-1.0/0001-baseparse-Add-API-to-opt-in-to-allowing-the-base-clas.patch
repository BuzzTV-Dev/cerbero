+    gboolean allow_duplicated_pts)
+{
+  parse->priv->allow_duplicated_pts = allow_duplicated_pts;
+  GST_INFO_OBJECT (parse, "Allow duplicated PTS: %s",
+      allow_duplicated_pts ? "yes" : "no");
+}
