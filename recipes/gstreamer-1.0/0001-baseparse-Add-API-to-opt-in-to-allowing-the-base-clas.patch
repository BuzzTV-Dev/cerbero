   pull_and_check (h, h264_aud, 200, 0);
   pull_and_check (h, h264_idr_slice_1, 200, 0);
-  pull_and_check (h, h264_idr_slice_2, -1, 0);
+  pull_and_check (h, h264_idr_slice_2, 200, 0);
 
