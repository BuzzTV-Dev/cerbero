@@ -1060,7 +1060,7 @@ GST_START_TEST (test_parse_sliced_nal_nal)
   fail_unless_equals_clocktime (gst_harness_query_latency (h), 0);
 
   /* test some flow with 2 slices.
-   * 1st slice gets the input PTS, second gets NONE */
