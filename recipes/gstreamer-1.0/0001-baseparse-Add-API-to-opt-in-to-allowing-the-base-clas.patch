-  pull_and_check (h, h264_idr_slice_2, -1, 0);
+  /* Both slices from the first AU get the PTS from the input buffer */
+  pull_and_check (h, h264_idr_slice_1, 100, 0);
+  pull_and_check (h, h264_idr_slice_2, 100, 0);
 
