From 3f047e363678ff618067b273e45d682467ed7c8b Mon Sep 17 00:00:00 2001
From: Maksym Vasylchuk <max@buzztv.com>
Date: Mon, 31 Aug 2026 19:36:03 +0300
Subject: [PATCH 3/4] conv: guard nl_langinfo on the function, not just its
 header

Bionic ships <langinfo.h> at every API level but only declares nl_langinfo
from API 26 on, so building against API 24 sets HAVE_LANGINFO_H, takes this
branch and fails with "use of undeclared identifier 'nl_langinfo'".

configure already probes the function (it is in the AC_CHECK_FUNCS list),
so require HAVE_NL_LANGINFO as well. Where the function is missing,
vbi_locale_codeset() falls back to bind_textdomain_codeset()'s answer,
which may be NULL -- a documented return value.
---
 src/conv.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/conv.c b/src/conv.c
index aa8fb8d..9937ac6 100644
--- a/src/conv.c
+++ b/src/conv.c
@@ -1253,7 +1253,7 @@ vbi_locale_codeset		(void)
 
 	dst_format = bind_textdomain_codeset (vbi_intl_domainname, NULL);
 
-#ifdef HAVE_LANGINFO_H
+#if defined HAVE_LANGINFO_H && defined HAVE_NL_LANGINFO
 	if (NULL == dst_format)
 		dst_format = nl_langinfo (CODESET);
 #endif
